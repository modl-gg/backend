# Reverse proxy / client IP resolution. Set when running behind a trusted proxy or CDN so per-IP rate
# limiting and X-Forwarded-Host tenant resolution see the real client IP instead of the edge IP.
# Behind Cloudflare: MODL_TRUST_PROXY_HEADERS=true and MODL_CLIENT_IP_HEADER=CF-Connecting-IP (authoritative,
# so MODL_TRUSTED_PROXY_COUNT is unused). Behind a plain proxy, set the count to the number of trusted hops.
MODL_TRUST_PROXY_HEADERS=
MODL_TRUSTED_PROXY_COUNT=
MODL_CLIENT_IP_HEADER=
